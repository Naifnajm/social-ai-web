# --- required ---
SAI_DOMAIN=app.example.com
POSTGRES_PASSWORD=change-me
SAI_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters

# --- e-mail (invitations, password reset, reports) ---
SAI_SMTP_HOST=
SAI_SMTP_PORT=587
SAI_SMTP_USER=
SAI_SMTP_PASSWORD=
SAI_MAIL_FROM=Stravica Social <no-reply@example.com>

# --- social network apps for one-click connect (optional: each company can also bring its own) ---
SAI_META_APP_ID=
SAI_META_APP_SECRET=
SAI_META_VERIFY_TOKEN=
SAI_THREADS_APP_ID=
SAI_THREADS_APP_SECRET=
SAI_LINKEDIN_CLIENT_ID=
SAI_LINKEDIN_CLIENT_SECRET=
SAI_X_CLIENT_ID=
SAI_X_CLIENT_SECRET=
SAI_TIKTOK_CLIENT_KEY=
SAI_TIKTOK_CLIENT_SECRET=

# --- subscriptions (Stripe) ---
SAI_STRIPE_SECRET_KEY=
SAI_STRIPE_WEBHOOK_SECRET=
SAI_STRIPE_PRICE_STARTER_MONTH=
SAI_STRIPE_PRICE_STARTER_YEAR=
SAI_STRIPE_PRICE_PRO_MONTH=
SAI_STRIPE_PRICE_PRO_YEAR=
SAI_STRIPE_PRICE_BUSINESS_MONTH=
SAI_STRIPE_PRICE_BUSINESS_YEAR=
